iosApp/build/
iosApp/fastlane/report.xml
iosApp/fastlane/README.md
iosApp/fastlane/test_output/
iosApp/fastlane/screenshots/
iosApp/Pods/

# Ruby / Bundler — gem deps installed at CI time
.bundle/
vendor/bundle/
